{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "A Colyseus multiplayer server",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "prestart": "cd ../shared && bun run build",
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "prebuild": "cd ../shared && bun run build",
    "build": "rimraf build && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "pretest": "cd ../shared && bun run build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus-chat/shared": "workspace:*",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">= 22.0.0"
  }
}
